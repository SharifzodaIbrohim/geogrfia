# Geografia — environment template (current stack)
# -------------------------------------------------
# Ubuntu:
#   cp .env.example .env
#   nano .env
#   chmod 600 .env
# systemd: EnvironmentFile=/opt/geogrfia/.env
#
# Render: set the same keys in Dashboard → Environment
# (do not commit real .env)

# === Required (production / Ubuntu) ===
# PostgreSQL — only production backend
DATABASE_URL=postgresql://geografia:CHANGE_ME@127.0.0.1:5432/geografia

# Session / JWT signing key (≥32 random characters)
JWT_SECRET=replace-with-long-random-string-at-least-32-chars

# Mark environment (enables prod DB rules)
FLASK_ENV=production
# APP_ENV=production

# === Session TTL (seconds) ===
USER_SESSION_TTL=604800
ADMIN_SESSION_TTL=43200

# === Optional: fail boot if secrets weak ===
# GEOGRAFIA_STRICT_SECRETS=1

# === Optional: Google OAuth (profile / public quiz) ===
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# === Backend safety ===
# JSON file backend is for local/dev only.
# Never leave this on in real production:
ALLOW_JSON_BACKEND=0

# === Public URL (optional; Cloudflare / geografia.tj later) ===
# PUBLIC_BASE_URL=https://geografia.tj

# === Gunicorn (document only — real flags go in systemd ExecStart) ===
# Recommended on i3-3220 / 8GB: --workers 2 --bind 127.0.0.1:8000
