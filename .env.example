# Geografia — environment template
# Copy to .env for local. On Render set in Dashboard → Environment.

# --- Required in production ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/geografia
JWT_SECRET=replace-with-python-secrets-token_urlsafe-48

# GEOGRAFIA_STRICT_SECRETS=1

# --- Session TTL (P1.3) seconds ---
USER_SESSION_TTL=604800
ADMIN_SESSION_TTL=43200

# --- Rate limits (P1.4) requests per window ---
# RL_ADMIN_LOGIN=5
# RL_ADMIN_LOGIN_WINDOW=60
# RL_STUDENT_LOGIN=20
# RL_QUIZ_START=10
# RL_QUIZ_SUBMIT=30

# --- Optional ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOW_JSON_BACKEND=0
# CONTENT_SECURITY_POLICY=
# HSTS_VALUE=max-age=31536000; includeSubDomains
