# Geografia — environment template (P0.9)
# Copy to .env for local dev. On Render set these in the Dashboard → Environment.
# NEVER commit real values.

# --- Required in production ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/geografia
JWT_SECRET=replace-with-python-secrets-token_urlsafe-48

# Force hard-fail on boot if secrets invalid (recommended on Render after JWT_SECRET is set)
# GEOGRAFIA_STRICT_SECRETS=1

# --- Optional ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# USER_SESSION_TTL=604800
# ADMIN_SESSION_TTL=43200

# Emergency only — never leave on in production
# ALLOW_JSON_BACKEND=0

# FLASK_ENV=production
