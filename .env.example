# Geografia — environment template
# Copy:  cp .env.example .env
# Ubuntu:  /opt/geogrfia/.env  (chmod 600)
# Render: Dashboard → Environment

# --- Required in production ---
DATABASE_URL=postgresql://geografia:CHANGE_ME@127.0.0.1:5432/geografia
JWT_SECRET=replace-with-long-random-string-at-least-32-chars

# Optional strict mode (fail boot if secrets weak)
# GEOGRAFIA_STRICT_SECRETS=1

# --- Session TTL (seconds) ---
USER_SESSION_TTL=604800
ADMIN_SESSION_TTL=43200

# --- Gunicorn (document only; set in systemd ExecStart) ---
# workers: 2 on i3-3220 / 8GB is a good start

# --- Optional Google OAuth ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Backend safety ---
# Never enable JSON backend in real production unless emergency:
# ALLOW_JSON_BACKEND=0

# --- Public URL (optional, for absolute links later) ---
# PUBLIC_BASE_URL=https://geografia.tj
