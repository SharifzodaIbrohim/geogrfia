# Nginx reverse proxy for Geografia on Ubuntu.
# Copy to /etc/nginx/sites-available/geografia and enable.
# TLS: certbot --nginx -d geografia.tj
# Or put Cloudflare Tunnel in front and keep only localhost.

upstream geografia_app {
    server 127.0.0.1:8000;
    keepalive 8;
}

server {
    listen 80;
    server_name geografia.tj www.geografia.tj;

    client_max_body_size 20m;

    location / {
        proxy_pass http://geografia_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
